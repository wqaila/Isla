// 复制本文件为 config.h,再填你自己的值(不要把真实密码 push 到 Git)
//   cp config.h.example config.h
// 服务地址就是本机在局域网里的 IP,本机访问也可填 127.0.0.1。

#ifndef CONFIG_H
#define CONFIG_H

// WiFi
#define WIFI_SSID       "your_wifi_ssid"
#define WIFI_PASS       "your_wifi_password"

// 本机服务器(运行 server/app.py 的那台电脑)
#define SERVER_HOST     "192.168.1.100"
#define SERVER_PORT     8000

// 分组与设备标识(任务卡"提交与迁移"需要)
#define GROUP_ID        "G03"
#define DEVICE_ID       "esp32s3-eye-01"

// ============================================================
//   传感器模式开关
//   硬件 = ESP32-S3-EYE,板载 QMA7981 三轴加速度计
//          I2C: SDA=GPIO4  SCL=GPIO5  地址=0x12(无需外接线)
// ============================================================
// USE_QMA7981 = 1  : 读板载真实传感器,上传 status="ok"
// USE_QMA7981 = 0  : 用合成波形生成数据(仅验证链路),
//                    status="simulated"
#define USE_QMA7981     1

#endif
